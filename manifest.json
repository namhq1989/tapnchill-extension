{
  "manifest_version": 3,
  "name": "BapBi (Dev)",
  "description": "An app designed to boost your productivity and bring relaxation to your day!",
  "version": "1.0.6",
  "action": {
    "default_popup": "index.html",
    "default_icon": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "permissions": [
    "offscreen",
    "storage",
    "sidePanel",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "side_panel": {
    "default_path": "src/modules/note/panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "BapBi"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
