{
  "manifest_version": 3,
  "name": "BapBi",
  "description": "An app designed to boost your productivity and bring relaxation to your day!",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html",
    "default_icon": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "permissions": [
    "offscreen",
    "storage"
  ],
  "content_security_policy": {
    "script-src": "'self' https://apis.google.com https://www.gstatic.com https://www.googleapis.com https://securetoken.googleapis.com"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
